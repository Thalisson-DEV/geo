{
  "name": "geo-field-app-tmp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "e2e": "playwright test e2e/characterization e2e/piloto e2e/fase4 e2e/sw e2e/a11y e2e/visual",
    "e2e:baseline": "playwright test e2e/baseline",
    "e2e:report": "playwright show-report e2e/.report",
    "e2e:retomada": "playwright test e2e/piloto",
    "e2e:a11y": "playwright test e2e/a11y",
    "e2e:visual:atualizar": "playwright test e2e/visual --update-snapshots",
    "e2e:desempenho": "playwright test e2e/baseline/perf.spec.ts --project=android",
    "e2e:videos": "playwright test -c playwright.video.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "barcode-detector": "3.2.2",
    "dexie": "^4.4.2",
    "jwt-decode": "^4.0.0",
    "material-icons": "^1.13.14",
    "pdfjs-dist": "4.10.38",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/dexie": "^1.3.32",
    "@vitest/browser-playwright": "^5.1.1",
    "istanbul-lib-instrument": "^6.0.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
